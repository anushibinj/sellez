SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/sellez
DATABASE_USERNAME=sellez
DATABASE_PASSWORD=sellez
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=sellez_access
REFRESH_COOKIE_NAME=sellez_refresh
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT=5
OTP_SEND_WINDOW_MINUTES=10
OTP_FIXED_CODE=
SUPER_ADMIN_EMAILS=owner@sellez.local
# Storage: which backend persists uploads (local | s3 | firebase). Reads for every
# backend are proxied through GET /api/media/{key}; the browser never hits S3/Firebase
# directly, so those buckets can stay private.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/media
STORAGE_IMAGE_MAX_DIMENSION=1600
STORAGE_IMAGE_QUALITY=0.82
# s3 backend (also any S3-compatible server: SeaweedFS, MinIO, R2, ...)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false
# firebase backend
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_PATH=
EMAIL_PROVIDER=logging
EMAIL_FROM=noreply@sellez.local
AWS_REGION=us-east-1
SNS_TOPIC_ARN=
LISTING_MAX_IMAGES=6
LISTING_CURRENCIES=USD,INR,EUR,GBP,AED,CAD,AUD
LISTING_DEFAULT_CURRENCY=USD
CHAT_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_FILE_SIZE=8MB
UPLOAD_MAX_REQUEST_SIZE=20MB
BAN_EXPIRY_JOB_MS=60000
