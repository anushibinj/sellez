# Root URL of the Spring Boot backend. The browser calls it directly (no Next.js proxy),
# so it must be reachable from the browser and the backend's CORS_ALLOWED_ORIGINS must
# list this app's origin (e.g. http://localhost:3000). The chat WebSocket URL is derived
# from this automatically (ws:// for http, wss:// for https).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_LISTING_CURRENCIES=USD,INR,EUR,GBP,AED,CAD,AUD
NEXT_PUBLIC_LISTING_DEFAULT_CURRENCY=USD
